// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  firstname String
  lastname  String
  email     String  @unique
  password  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  role_id   Int
  suffix    String?
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  
  receiveAlarmEmail Boolean @default(false)

  roles           roles             @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_logs       user_logs[]
  database_backup database_backup[]
}

model roles {
  id        Int       @id @default(autoincrement())
  role      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(2)
  updatedAt DateTime? @updatedAt @db.Timestamptz(2)
  users     users[]
}

model user_logs {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  action      String
  description String?
  ip_address  String?
  user_agent  String?
  createdAt   DateTime @default(now())

  users users? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id])
  @@index([createdAt])
}

model database_backup {
  id        Int      @id @default(autoincrement())
  filename  String   @unique
  path      String
  size      BigInt
  createdAt DateTime @default(now())

  createdById Int?
  createdBy   users? @relation(fields: [createdById], references: [id])

  @@index([createdAt])
  @@index([createdById])
}

model terminal_nodes {
  id                       Int       @id @default(autoincrement())
  fiberVuId                Int       @unique
  cityId                   Int
  cityName                 String
  clientId                 Int
  clientIdentifier         String
  clientName               String
  clientOuterIdentifier    String
  comment                  String?
  contact                  String
  contract                 String
  createdAt                DateTime
  createdById              Int
  createdByName            String
  customVlanTaggingIptvId   Int?
  customVlanTaggingNetId    Int?
  deletedAt                DateTime?
  deletedById              Int?
  email                    String
  fixIp                    String?
  hookedAt                 DateTime
  hookedById               Int
  hookedByName             String
  isFtth                   Boolean
  isPppoe                  Boolean
  isPppoeActive            Boolean
  language                 String
  mapDataId                Int
  mapDataName              String
  modifiedAt               DateTime
  modifiedById             Int
  modifiedByName           String
  name                     String
  number                   Int
  numberExt                String
  oltName                  String
  onuOltId                 Int
  opticalDeviceId          Int
  outerIdentity            String?
  packageName              String
  password                 String
  phone                    String
  radiusPassword           String?
  radiusUsername           String?
  rfEnabled                Boolean
  serialNumber             String
  serviceAreaId            Int?
  serviceAreaName          String?
  sipData                  String?
  status                   String
  statusId                 Int
  statusOperational        Boolean
  streetId                 Int
  streetName               String
  terminalNodeOltId        String
  todoCount                Int?
  todoTaskIds              String?
  tr069Enabled             Boolean
  voipProvider             String
  voipProviderId           String
  wifi                     Boolean

  dailyConsumptions daily_consumption[]
}

model daily_consumption {
  id             Int           @id @default(autoincrement())
  fiberVuId      Int           @unique
  clientName     String
  consumptionDay String
  createdAt      DateTime
  down           String
  terminalNodeId Int
  up             String

  terminalNode   terminal_nodes @relation(fields: [terminalNodeId], references: [id])

  @@index([terminalNodeId])
  @@index([consumptionDay])
}